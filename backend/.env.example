# Hairstyle image editing (always edits the customer's own photo)
IMAGE_EDIT_PROVIDER=gemini            # gemini | nvidia
GEMINI_API_KEY=                       # needs a billing-enabled key: the free tier has no image-model quota
GEMINI_FAST_MODEL=gemini-2.5-flash-image
GEMINI_HQ_MODEL=gemini-3-pro-image-preview

# NVIDIA NIM: the hosted API only accepts NVIDIA's example images, so point these at a self-hosted NIM
NVIDIA_NGC_API_KEY=
NVIDIA_NIM_FAST_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
NVIDIA_NIM_HQ_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-kontext-dev

MAX_PARALLEL_GENERATIONS=4
GENERATION_MAX_ATTEMPTS=2
IDENTITY_MIN_SIMILARITY=0.363         # SFace cosine similarity, same-person threshold
HAIR_COLOUR_MAX_DELTA_E=18
USE_STYLE_REFERENCE_IMAGE=false       # enable once catalogue reference photos really show each style

# OpenRouter (Gemini / GPT image models, pay-per-use with OpenRouter credits)
# IMAGE_EDIT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=google/gemini-2.5-flash-image
OPENROUTER_HQ_MODEL=google/gemini-3-pro-image

# Cloudflare Workers AI - FLUX.2-klein-4B, free plan ~90 previews/day
# IMAGE_EDIT_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
